  "folderId": "dc487f89-30a6-48b7-8de8-e0cce0315e1b",
  "document": {
    "schemaVersion": 1,
    "kind": "report",
    "pages": [
      {
        "id": "p1",
        "name": "Assignment Booked"
      },
      {
        "id": "pdata",
        "name": "Data",
        "visibility": "hidden"
      }
    ],
    "elements": [
      {
        "id": "tbl-assignments",
        "kind": "table",
        "name": "Assignments",
        "visibleAsSource": true,
        "source": {
          "kind": "warehouse-table",
          "connectionId": "f45a23e2-7b17-41d4-aa34-f2ed38483a53",
          "path": [
            "BARTONDB",
            "GOLD",
            "ASSIGNMENT_PROD"
          ]
        },
        "columns": [
          {
            "id": "col-an",
            "formula": "[ASSIGNMENT_PROD/Assignment Number]",
            "name": "Assignment Number"
          },
          {
            "id": "col-main-spec",
            "formula": "[ASSIGNMENT_PROD/Main Specialty]",
            "name": "Main Specialty"
          },
          {
            "id": "col-sub-spec",
            "formula": "[ASSIGNMENT_PROD/Sub Specialty]",
            "name": "Sub Specialty"
          },
          {
            "id": "col-asgn-type",
            "formula": "[ASSIGNMENT_PROD/Reassignment]",
            "name": "Assignment Type"
          },
          {
            "id": "col-provider-type",
            "formula": "If(IsNull([ASSIGNMENT_PROD/SF Long Provider Type]) or [ASSIGNMENT_PROD/SF Long Provider Type] = \"\", \"Other\", [ASSIGNMENT_PROD/SF Long Provider Type])",
            "name": "Provider Type"
          },
          {
            "id": "col-ae",
            "formula": "[ASSIGNMENT_PROD/AE]",
            "name": "AE"
          },
          {
            "id": "col-ae-entity",
            "formula": "[ASSIGNMENT_PROD/AE Company]",
            "name": "AE Entity"
          },
          {
            "id": "col-recruiter",
            "formula": "[ASSIGNMENT_PROD/Recruiter]",
            "name": "Recruiter"
          },
          {
            "id": "col-state",
            "formula": "[ASSIGNMENT_PROD/Worksite State]",
            "name": "Worksite State"
          },
          {
            "id": "col-loa",
            "formula": "[ASSIGNMENT_PROD/Assignment LOA]",
            "name": "Assignment LOA"
          },
          {
            "id": "col-bill",
            "formula": "[ASSIGNMENT_PROD/Bill Rate]",
            "name": "Bill Rate"
          },
          {
            "id": "col-pay",
            "formula": "[ASSIGNMENT_PROD/Pay Rate]",
            "name": "Pay Rate"
          },
          {
            "id": "col-created",
            "formula": "[ASSIGNMENT_PROD/Assignment Created Date]",
            "name": "Assignment Created Date"
          },
          {
            "id": "col-prod",
            "formula": "[ASSIGNMENT_PROD/prod_assignment]",
            "name": "Prod Assignment"
          },
          {
            "id": "col-week-ending",
            "formula": "DateAdd(\"day\", 5, DateTrunc(\"week\", [Assignment Created Date]))",
            "name": "Week Ending",
            "format": {
              "kind": "datetime",
              "formatString": "%Y-%m-%d"
            }
          },
          {
            "id": "col-week-label",
            "formula": "DateFormat(DateAdd(\"day\", 5, DateTrunc(\"week\", [Assignment Created Date])), \"%Y-%m-%d\")",
            "name": "Week Label"
          },
          {
            "id": "col-weeks-back",
            "formula": "DateDiff(\"week\", DateTrunc(\"week\", [Assignment Created Date]), DateTrunc(\"week\", Today()))",
            "name": "Weeks Back",
            "format": {
              "kind": "number",
              "formatString": ",.0f"
            }
          },
          {
            "id": "col-scope",
            "formula": "If([Weeks Back] >= 0 and [Weeks Back] <= 4 and [Prod Assignment] = \"Yes\", \"Last 5 Weeks\", \"Excluded\")",
            "name": "Booking Scope"
          },
          {
            "id": "col-projected-billing",
            "formula": "[Bill Rate] * [Assignment LOA] * 8",
            "name": "Projected Billing",
            "format": {
              "kind": "number",
              "formatString": "$,.0f"
            }
          },
          {
            "id": "col-gm-dollars",
            "formula": "([Bill Rate] - [Pay Rate]) * [Assignment LOA] * 8",
            "name": "GM Dollars",
            "format": {
              "kind": "number",
              "formatString": "$,.0f"
            }
          },
          {
            "id": "col-gm-pct",
            "formula": "[GM Dollars] / NullIf([Projected Billing], 0)",
            "name": "GM Percent",
            "format": {
              "kind": "number",
              "formatString": ",.2%"
            }
          },
          {
            "id": "col-repeat",
            "formula": "If([Assignment Type] = \"New Assignment\", 0, 1)",
            "name": "Repeat Booking",
            "format": {
              "kind": "number",
              "formatString": ",.0f"
            }
          }
        ],
        "order": [
          "col-an",
          "col-main-spec",
          "col-sub-spec",
          "col-asgn-type",
          "col-provider-type",
          "col-ae",
